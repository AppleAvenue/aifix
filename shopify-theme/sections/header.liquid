{% liquid
  assign logo_text = section.settings.logo_text | default: shop.name
%}

<nav class="navbar" data-section-id="{{ section.id }}" data-section-type="header">
  <div class="nav-container">
    <div class="nav-logo">
      <a href="/">{{ logo_text }}</a>
    </div>

    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-menu" id="navMenu">
      {% for link in linklists[section.settings.menu].links %}
        <li>
          <a href="{{ link.url }}" class="nav-link">{{ link.title | upcase }}</a>
        </li>
      {% endfor %}
    </ul>

    <div class="nav-actions">
      <div class="search-container">
        <form action="/search" method="get" class="search-form">
          <input
            type="text"
            name="q"
            class="search-input"
            placeholder="Search products..."
            autocomplete="off"
          >
          <button type="submit" class="search-btn" aria-label="Search">🔍</button>
        </form>
      </div>

      <button class="cart-btn" id="cartBtn" aria-label="Open cart">
        <span class="cart-icon">🛒</span>
        <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "SOLE THEORY"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
