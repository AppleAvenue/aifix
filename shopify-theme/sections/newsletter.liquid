<section class="newsletter-section" data-section-id="{{ section.id }}">
  <div class="newsletter-content">
    <h3>{{ section.settings.heading }}</h3>
    <p>{{ section.settings.subheading }}</p>

    {% form 'customer', class: 'newsletter-form' %}
      {% if form.posted_successfully? %}
        <p class="success-message">Thanks for subscribing!</p>
      {% endif %}

      <input
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder_text }}"
        required
        autocomplete="email"
      >
      <input type="hidden" name="contact[tags]" value="newsletter">
      <button type="submit">{{ section.settings.button_text }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE THEORY"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get exclusive access to new drops and special offers"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
