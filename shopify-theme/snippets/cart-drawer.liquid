<div class="cart-sidebar" id="cartSidebar">
  <div class="cart-header">
    <h3>YOUR CART</h3>
    <button class="cart-close" id="cartClose" aria-label="Close cart">&times;</button>
  </div>

  <div class="cart-items" id="cartItems">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="cart-item" data-line="{{ forloop.index }}">
          <div class="cart-item-image">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}">
            {% endif %}
          </div>

          <div class="cart-item-info">
            <div class="cart-item-name">{{ item.product.title }}</div>
            <div class="cart-item-details">
              {% unless item.product.has_only_default_variant %}
                {{ item.variant.title }}
              {% endunless %}
            </div>
            <div class="cart-item-details">Qty: {{ item.quantity }}</div>
            <div class="cart-item-price">{{ item.final_line_price | money }}</div>
          </div>

          <button
            class="cart-item-remove"
            data-line="{{ forloop.index }}"
            aria-label="Remove {{ item.product.title }}"
          >
            Remove
          </button>
        </div>
      {% endfor %}
    {% else %}
      <p class="empty-cart">Your cart is empty</p>
    {% endif %}
  </div>

  <div class="cart-footer">
    <div class="cart-total">
      <span>TOTAL:</span>
      <span id="cartTotal">{{ cart.total_price | money }}</span>
    </div>
    <a href="/checkout" class="checkout-btn">CHECKOUT</a>
  </div>
</div>
